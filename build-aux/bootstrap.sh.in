if test "$V" = 1 -o "$V" = 2; then
    set -x
fi

LANG=
MES_ARENA=${MES_ARENA-20000000}
export MES_ARENA
MES_MAX_ARENA=${MES_MAX_ARENA-${MES_ARENA}}
export MES_MAX_ARENA
MES_STACK=${MES_STACK-5000000}
export MES_STACK
MES_PREFIX=${MES_PREFIX-$PWD}

. ./config.sh
. ${srcdest}build-aux/configure-lib.sh
. ${srcdest}build-aux/cflags.sh

if test -n "@M2_PLANET@"; then
    echo "  KAEM         kaem.run"
    kaem --strict --verbose -f ${srcdest}kaem.run
fi

CPPFLAGS="-D HAVE_CONFIG_H=1 -I include"
libdir=$PWD/lib
export libdir

mkdir -p $compiler-lib
cp config.sh $compiler-lib/config.sh
cd $compiler-lib

srcdest=../${srcdest}
ln -sf ${srcdest}mes .
ln -sf ${srcdest}module .
ln -sf ${srcdest}src .
AM_CPPFLAGS="-D HAVE_CONFIG_H=1 -I ${srcdir} -I ${srcdest}include -I ../include -I include"
AM_CFLAGS="-L ${srcdest}lib -L $mes_cpu-mes"

if test $compiler = gcc; then
    AM_CFLAGS="-fno-builtin -nostartfiles -nostdlib $AM_CFLAGS"
fi

mkdir -p $mes_cpu-mes
cp ${srcdest}lib/$mes_kernel/$mes_cpu-mes-$compiler/crt1.c .
$CC -c $AM_CPPFLAGS $CPPFLAGS $AM_CFLAGS $CFLAGS crt1.c
cp crt1.o $mes_cpu-mes
if test -e crt1.s; then
    cp crt1.s $mes_cpu-mes
fi

if test $compilation_unit = unity; then
    . ${srcdest}build-aux/bootstrap-lib-unity.sh
else
    . ${srcdest}build-aux/bootstrap-lib.sh
fi

echo "  CCLD       bin/mes-mescc"
mkdir -p ../bin
$CC $AM_CFLAGS -o ../bin/mes-mescc -L . crt1.o $objects -lc -lmescc

cd ..
srcdest=

cp bin/mes-mescc bin/mes

(
    mkdir -p gcc-lib
    cp config.sh gcc-lib
    cd gcc-lib
    compiler=gcc
    if test -z "$srcdest"; then
        srcdest=../
        srcdir=../
    fi
    @SHELL@ ${srcdest}build-aux/build-source-lib.sh
)
