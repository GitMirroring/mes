#! /bin/sh
# -*-scheme-*-
MES_ARENA=40000
export MES_ARENA
export MES_BOOT
if [ "$MES" != guile ]; then
    MES_BOOT=boot-00.scm exec ${MES-bin/mes} < "$0"
fi
exec ${MES-bin/mes} --no-auto-compile -L ${0%/*} -L module -C module -s "$0" "$@"
!#

