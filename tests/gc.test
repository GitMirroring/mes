(define mes-core?
  (cond-expand
   (guile #f)
   (mes (eq? (current-module) (initial-module)))))

((if mes-core? core:display display) (gc-stats))
(gc)
((if mes-core? core:display display) (gc-stats))
((if mes-core? core:display display) "\n")
(define (loop n)
  (if (> n 0) (loop (- n 1))))
(loop 100000)
(gc)
((if mes-core? core:display display) (gc-stats))
((if mes-core? core:display display) "\n")
